# Build output
build/
build-*/
cmake-build-*/
compile_commands.json
.cache/

# Models are large and personal; keep them out of the repo.
*.gguf
models/

# Editors
.vscode/
.idea/
*.swp

# Claude Code's per-project settings
.claude/

# What the packaging scripts leave behind when they are run by hand. Each of
# these is somewhere a build or an archive lands; none of it belongs in the
# history, and all of it is a regeneratable copy of something that does.
dist/
out/
stage/
*.AppImage
*.dmg
*.tar.gz
Crucible-Setup.exe

# Crash and profiling leftovers, which appear next to whatever was being
# debugged and are worthless an hour later. A core dump is called `core` or
# `core.<pid>` -- and the pattern says so, because `core.*` also matched a
# source file called core.js and kept it out of the repository without a word.
core
core.[0-9]*
vgcore.*
perf.data
perf.data.old
*.log

# Python, for packaging/make_icons.py and anything else run from a checkout.
__pycache__/
*.pyc
.venv/

# Merge and patch debris.
*.orig
*.rej

# macOS writes one of these into every directory it looks at.
.DS_Store

# Matt's own notes. Thinking-in-progress that belongs on this machine rather
# than in the repository -- direction, scratch plans, anything not yet a
# decision the code has to honor.
notes/
